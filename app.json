{
  "expo": {
    "name": "FinGuide",
    "slug": "lira",
    "displayName": "FinGuide",
    "scheme": "com.stefano10.lira",
    "web": {
      "output": "server",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "android": {
      "package": "com.stefano10.lira",
      "newArchEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "8ba813fa-fa1c-417e-87be-d0950e10434e"
      }
    }
  }
}
